# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://typeroom:typeroom@postgres:5432/typeroom
DISCONNECT_GRACE_MS=20000
# Rooms with no connected human close after this many ms (the Privacy Policy says 10 minutes).
ROOM_IDLE_MS=600000
# true only behind a reverse proxy that overwrites X-Forwarded-For (the bundled nginx does).
TRUST_PROXY=false
POSTGRES_USER=typeroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=typeroom
WEB_PORT=8080

# Web (baked in at build time). Unset operator values render as [[PLACEHOLDERS]] on the legal pages.
VITE_SOCKET_URL=http://localhost:3000
VITE_CONTACT_EMAIL=
VITE_OPERATOR_NAME=
VITE_JURISDICTION=
VITE_LOG_RETENTION_DAYS=
VITE_HOSTING_PROVIDER=
# Defaults to https://github.com/raja-lovescoding/Typeroom
VITE_REPO_URL=
