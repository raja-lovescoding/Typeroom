# Copy to apps/web/.env for local development.
VITE_SOCKET_URL=http://localhost:3000

# Operator details shown on the About, Privacy, Terms and Contact pages.
# Anything left empty renders as a highlighted [[PLACEHOLDER]] and `vite build` warns about it.
VITE_CONTACT_EMAIL=
VITE_OPERATOR_NAME=
# Governing law for the Terms of Use, e.g. "England and Wales"
VITE_JURISDICTION=
# How many days server/proxy logs are kept. Must match your actual log retention.
VITE_LOG_RETENTION_DAYS=
# Who hosts the servers, e.g. "Hetzner Online GmbH (Germany)"
VITE_HOSTING_PROVIDER=
# Optional; defaults to https://github.com/raja-lovescoding/Typeroom
VITE_REPO_URL=
