{
  "name": "@typeroom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@typeroom/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
